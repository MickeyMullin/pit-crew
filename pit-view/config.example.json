{
  "repo": "Port-City/meridian",
  "viewer": "",
  "people": [],
  "tickets": [
    {
      "enabled": true,
      "kind": "jira",
      "name": "Jira",
      "source": "title-then-branch",
      "pattern": "\\b[a-z]+-\\d+\\b",
      "baseUrl": "",
      "linkTemplate": "{baseUrl}/browse/{key}"
    },
    {
      "enabled": true,
      "kind": "github-issues",
      "name": "GitHub",
      "source": "linked-issues",
      "pattern": "",
      "baseUrl": "",
      "linkTemplate": "https://github.com/{repo}/issues/{n}"
    }
  ],
  "refreshSeconds": 300,
  "idleMinutes": 90,
  "todayStartsAt": "local",
  "bots": [
    "dependabot",
    "renovate"
  ],
  "reportsDir": "~/agents/output",
  "density": "comfortable",
  "timeFormat": "12h",
  "showAgentColumn": false,
  "maxConcurrentReviews": 2,
  "selfReviewOverCap": false,
  "extraReviewInstructions": "",
  "allowedHosts": [],
  "agent": {
    "runner": "claude",
    "claudeModel": "sonnet"
  }
}
