{
  "name": "pit-view",
  "version": "0.1.0",
  "private": true,
  "description": "Local dashboard for tracking pull requests in one GitHub repository.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "PIT_VIEW_INSTANCE=dev node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "service:install": "node scripts/service.ts install",
    "service:uninstall": "node scripts/service.ts uninstall",
    "service:status": "node scripts/service.ts status",
    "service:restart": "node scripts/service.ts restart"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "marked": "18.0.11"
  }
}
